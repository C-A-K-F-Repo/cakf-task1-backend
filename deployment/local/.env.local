DB_URL=postgresql+asyncpg://user:password@db:5432/fastapi_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=fastapi_db

JWT_SECRET=local-dev-secret
FROM_EMAIL=dev@example.com
APP_PASSWORD=dev-app-password

TWILIO_ACCOUNT_SID=sid
TWILIO_AUTH_TOKEN=token
TWILIO_SERVICE_SID=service
TWILIO_SENDER_PHONE=+10000000000

LOG_LEVEL=INFO
LOG_STDOUT_ENABLED=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=cakf-task1-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_ENABLED=true
OTEL_LOGS_ENABLED=true

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
